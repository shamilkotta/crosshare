{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "es5",
  "ignorePatterns": [
    "pnpm-lock.yaml",
    ".cursor/**",
    "dist/**",
    "build/**",
    ".expo/**",
    "apps/mobile/ios/**",
    "apps/mobile/android/**",
    "apps/mac/**",
    "**/*.swift",
    "**/*.kt",
    "**/*.java"
  ]
}
